ios = ENV["IOS_VERSION"]
suffix = ios ? " (#{ios})" : ""

devices([
  "iPhone 16 Pro Max#{suffix}",
  "iPhone 16 Pro#{suffix}",
])

languages([
  "en-US",
])

# The scheme that contains the UI test target
scheme("Interclip")
app_identifier("com.filiptronicek.iclip")

# Where to save screenshots
output_directory("./fastlane/screenshots")

# Clean slate each run
clear_previous_screenshots(true)

# Show a clean status bar (9:41, full battery, full signal)
override_status_bar(true)
